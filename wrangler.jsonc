{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "el-especulador-del-wow",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "build": {"command": "node scripts/prepare-downloads.mjs"},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {"bindings": [{"name": "PORTFOLIO", "class_name": "Portfolio"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Portfolio"]}],
  "observability": {"enabled": false}
}
